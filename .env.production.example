# ─── AI Agent Platform — Production Environment Variables ────────────────────
# Copy this file: cp .env.production.example .env.production
# Then fill in your values

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING

# ── Supabase Database (PostgreSQL) ────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── Manus OAuth (keep as-is for Manus login) ─────────────────────────────────
VITE_APP_ID=YOUR_MANUS_APP_ID
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im
OWNER_OPEN_ID=YOUR_OWNER_OPEN_ID
OWNER_NAME=YOUR_NAME

# ── AI Models ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
UNSPLASH_ACCESS_KEY=...
SERPER_API_KEY=...

# ── Built-in Forge (Manus AI APIs) ───────────────────────────────────────────
BUILT_IN_FORGE_API_URL=https://api.manus.im
BUILT_IN_FORGE_API_KEY=...
VITE_FRONTEND_FORGE_API_KEY=...
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=souqratesignal.online
